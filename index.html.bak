<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Cosmic Void | Explore Your Universe</title>
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;500;700&display=swap"
        rel="stylesheet">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7237384529818812"
        crossorigin="anonymous"></script>
</head>

<body>
    <!-- Immersive Visual Canvas -->
    <canvas id="cosmosCanvas"></canvas>

    <!-- Minimal Ad Container (Floating Bottom) -->
    <div id="adLayer">
        <div class="ad-container glass-panel">
            <ins class="adsbygoogle" style="display:block; width: 320px; height: 50px;"
                data-ad-client="ca-pub-7237384529818812" data-ad-slot="3580735781" data-ad-format="auto"
                data-full-width-responsive="true"></ins>
        </div>
    </div>

